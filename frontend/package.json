  "main": "index.js",
  "scripts": {
    "build": "cross-env NODE_ENV=production webpack --config webpack/webpack.config.js --env env=prod",
    "start": "webpack serve --config webpack/webpack.config.js --env env=dev",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "lint": "eslint --fix",
    "lint-staged": {
      "*.{css,scss}": "npm run stylelint:fix",
      "*.{js,jsx,ts,tsx}": "npm run lint",
      "*.{js,jsx,ts,tsx,json,css,scss,md}": "npm run format"
    },
    "format": "prettier --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" --ignore-path ./.prettierignore",
    "check": "npm run stylelint:fix && npm run lint && npm run format",
    "commit": "npm run check && cz",
    "prepare": "husky",
    "version": "standard-version"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "autoprefixer": "^10.6.1",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "cssnano": "^8.0.10",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.8",
    "react-refresh": "^0.19.0",
    "sass": "^1.104.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "stylelint": "^17.15.0",
